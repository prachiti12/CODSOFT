def chatbot(user_input):
    user_input = user_input.lower()

    if "hello" in user_input or "hi" in user_input:
        return "Hello! How can I help you? 😊"

    elif "how are you" in user_input:
        return "I'm doing great! Thanks for asking."

    elif "your name" in user_input or "who are you" in user_input:
        return "I'm a simple rule-based chatbot."

    elif "help" in user_input:
        return "I can answer greetings, basic questions, and say goodbye."

    elif "bye" in user_input or "exit" in user_input:
        return "Goodbye! Have a nice day 👋"

    else:
        return "Sorry, I didn't understand that. Can you try again?"
print("Chatbot: Hello! Type 'bye' to end the conversation.")

while True:
    user = input("You: ")
    reply = chatbot(user)
    print("Chatbot:", reply)

    if "bye" in user.lower() or "exit" in user.lower():
        break
